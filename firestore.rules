rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'marouananouar02@gmail.com';
    }

    // Global Safety Net
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt']) &&
             data.email == request.auth.token.email &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role is string && (data.role == 'visitor' || data.role == 'admin') &&
             (data.role == 'admin' ? request.auth.token.email == 'marouananouar02@gmail.com' : true) &&
             data.createdAt is string && data.createdAt.size() <= 30;
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    match /SecretArea/{userId} {
      // Only the user themselves can read their profile
      allow read: if isOwner(userId);
      
      // Creating their own profile
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      
      // Update is not implemented yet but could be secured here
      allow update: if isOwner(userId) && isValidUserProfile(incoming());
      
      allow delete: if false;
    }
  }
}
