{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in the SecretArea collection",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["visitor", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "displayName", "role", "createdAt"]
    }
  },
  "firestore": {
    "SecretArea/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "Profiles for visitors logging in via Discord/Google"
    }
  }
}
